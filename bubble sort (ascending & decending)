// assending order
public class Main
{
	public static void main(String[] args) {
	   int arr[]={12,6,1,2,3};
	   int i,j,temp;
	   for(i=0;i<arr.length;i++)
	   {
	       for(j=i+1;j<arr.length;j++)
	       {
	           if(arr[i]>arr[j])
	           {
	               temp=arr[i];
	               arr[i]=arr[j];
	               arr[j]=temp;
	           }
	       }
	   }
	   for(int x:arr)
	   System.out.print(x+" ");
	}
}

