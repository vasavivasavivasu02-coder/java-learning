public class Main
{
	public static void main(String[] args) {
		int arr[]={10,15,20,25,36,42,53,61};
		int target=42;
		int start=0,end=arr.length-1,mid;
		while(start<=end)
		{
		    mid=(start+end)/2;
		    if(arr[mid]==target)
		    {
		        System.out.print(mid);
		        return;
		    }
		    else if (arr[mid]<target)
		    start=mid+1;
		    else if(arr[mid]>target)
		    end=mid-1;
		}
		System.out.print(-1);
	}
}
