class Student
{
    String name;
    int id;
    Student(String name,int id)
    {
        this.name=name;
        this.id=id;
    }
}
class Main
{
    public static void main(String[]args)
    {
        Student obj=new Student("vasavi",170);
        System.out.println("name:"+obj.name+" and id:"+obj.id);
    }
}
